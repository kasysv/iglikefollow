APP_NAME=IGLIKEFOLLOW
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ALLOW_INDEXING=false
INDEXABLE_HOST=www.iglikefollow.com

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=zh_TW
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- M4C staging 能力開關(⛔ 全部 default off;非機密) ----
# 「credential 已填」不等於「允許連線」:credential 一律由 Owner 在後台
# 加密輸入,絕不放進 .env。打開任何能力需要另一次明確批准。
PAYMENTS_SANDBOX_ENABLED=false
INVOICE_SANDBOX_ENABLED=false
# 只在 APP_ENV=staging 有意義;production 無條件 fail closed。
FULFILLMENT_STAGING_THEMOSTPANEL_DISPATCH_ENABLED=false
# 履約狀態輪詢(每 10 分鐘,固定);只允許 staging。
FULFILLMENT_STATUS_POLLING_ENABLED=false
# staging 部署預設不可被索引;readiness 會把可索引 staging 判為 blocker。
ALLOW_INDEXING=false
