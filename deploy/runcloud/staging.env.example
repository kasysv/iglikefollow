# =====================================================================
# M4C staging .env 範本(⛔ 只有 placeholder 與非機密安全值)
# =====================================================================
# secret 一律 <SET-IN-RUNCLOUD-ONLY>:只在 RunCloud env UI / server 上
# 設定,永不進 Git、Project、Control 或聊天。credential(綠界/LINE Pay/
# TheMostPanel)不放 .env——由 Owner 在 /admin 串接設定加密輸入。

APP_NAME=IGLIKEFOLLOW
APP_ENV=staging
APP_KEY=<SET-IN-RUNCLOUD-ONLY>
APP_DEBUG=false
APP_URL=https://<staging-subdomain.example.tld>

# ⛔ staging 永不可被索引;readiness 會把可索引 staging 判為 blocker。
ALLOW_INDEXING=false

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<staging-db-name>
DB_USERNAME=<staging-db-user>
DB_PASSWORD=<SET-IN-RUNCLOUD-ONLY>

SESSION_DRIVER=database
CACHE_STORE=database
# ⛔ 非 sync:jobs 必須進 queue 由 worker 處理。
QUEUE_CONNECTION=database
# database queue 的可見性逾時;worker --timeout 必須小於它(本輪 60 < 90)。
DB_QUEUE_RETRY_AFTER=90

MAIL_MAILER=log

# ---- 付款／發票／自動派單:⛔ 不由 .env 控制(M4C+R1) ----
#
# 綠界付款、LINE Pay、綠界發票的開關,以及 TheMostPanel 自動派單總開關,
# 都在 Owner 的 /admin「串接設定」裡,存在 production
# `integration_settings.is_enabled`。⛔ 這裡沒有對應的鍵,而且不該再加回來:
# 一個能否決 Owner 的旗標,結果就是 Owner 在後台按了開關卻沒有反應,然後
# 有人回來改這個檔案。
#
# 舊的 PAYMENTS_SANDBOX_ENABLED／INVOICE_SANDBOX_ENABLED／INVOICE_GATEWAY／
# FULFILLMENT_DRIVER／FULFILLMENT_DISPATCH_ENABLED／
# FULFILLMENT_STAGING_THEMOSTPANEL_DISPATCH_ENABLED／
# FULFILLMENT_STATUS_POLLING_ENABLED 已全部 deprecated,staging runtime
# 完全不讀。若既有 .env 還留著它們,不必刪也不會有作用。
# 狀態輪詢跟隨自動派單總開關,沒有獨立旗標。
#
# 要確認目前付款／派單是開還是關,執行:php artisan app:staging-readiness

# ---- 唯讀探針:仍由 env 控制,default off,與自動派單無關 ----
THEMOSTPANEL_READ_ONLY_ENABLED=false
